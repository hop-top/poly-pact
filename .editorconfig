root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Fixture bytes are conformance inputs: some files end without a newline on
# purpose. Editors leave them as they are.
[{spec/v1.0/fixtures/**,*.jws}]
insert_final_newline = unset
trim_trailing_whitespace = unset
