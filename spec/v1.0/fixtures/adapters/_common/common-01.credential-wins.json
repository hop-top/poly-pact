{
  "case_version": 1,
  "id": "COMMON-01.credential-wins",
  "title": "Identity headers never override the authenticated credential",
  "draft": ["8.5", "17.1"],
  "native_state": {
    "model": "common/1",
    "gateway": {
      "tenant_id": "acme",
      "environment_id": "https://gateway.example/environments/finance",
      "origin": "https://gateway.example",
      "header_allowlist": ["x-request-kind"]
    },
    "identities": [
      {
        "ref": "alice",
        "id": "https://idp.acme.example/alice",
        "realm": {"tenant_id": "acme", "environment_id": "https://gateway.example/environments/finance"},
        "workload": "https://workloads.acme.example/invoice-assistant",
        "secret": "tok-alice-7f3a9c1e5b2d"
      },
      {
        "ref": "bob",
        "id": "https://idp.acme.example/bob",
        "realm": {"tenant_id": "acme", "environment_id": "https://gateway.example/environments/finance"},
        "workload": "https://workloads.acme.example/report-runner",
        "secret": "tok-bob-41c8d0a97e6f"
      }
    ]
  },
  "request": {
    "method": "GET",
    "url": "https://gateway.example/invoices/INV-1042",
    "headers": {
      "X-User": "alice",
      "X-Principal": "https://idp.acme.example/alice",
      "X-Forwarded-User": "alice",
      "X-Client-Cert": "CN=alice,O=acme",
      "X-Acme-Identity": "alice"
    },
    "native_state_ref": "bob"
  },
  "expect": {
    "function": "authenticate_native",
    "outcome": "authenticated",
    "principal": {
      "id": "https://idp.acme.example/bob",
      "realm": {"tenant_id": "acme", "environment_id": "https://gateway.example/environments/finance"},
      "workload": "https://workloads.acme.example/report-runner"
    }
  }
}
