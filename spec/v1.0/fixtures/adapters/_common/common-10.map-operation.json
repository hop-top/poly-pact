{
  "case_version": 1,
  "id": "COMMON-10.map-operation",
  "title": "Credentials of a mapped request never appear in the operation context",
  "draft": ["10.2", "19"],
  "native_state": {
    "model": "common/1",
    "gateway": {
      "tenant_id": "acme",
      "environment_id": "https://gateway.example/environments/finance",
