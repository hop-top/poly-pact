      "header_allowlist": ["x-request-kind"]
    },
    "mappings": [
      {
        "version": "map-1",
        "routes": [
          {
            "method": "GET",
            "path": "/invoices/{id}",
            "action": "invoice.read",
            "resource": "https://invoices.example/invoices/{id}"
          },
          {
            "method": "POST",
            "path": "/invoices/{id}/approve",
            "action": "invoice.approve",
            "resource": "https://invoices.example/invoices/{id}"
          }
        ]
      }
    ],
    "identities": [
      {
        "ref": "alice",
        "id": "https://idp.acme.example/alice",
        "realm": {"tenant_id": "acme", "environment_id": "https://gateway.example/environments/finance"},
        "workload": "https://workloads.acme.example/invoice-assistant",
        "secret": "tok-alice-7f3a9c1e5b2d"
      }
    ]
  },
  "request": {
    "method": "POST",
    "url": "https://gateway.example/invoices/INV-1042/approve",
    "headers": {
