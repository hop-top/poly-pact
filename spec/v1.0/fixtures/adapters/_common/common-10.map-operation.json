      "X-Request-Kind": "approval",
      "Cookie": "session=sess-cookie-93ab1f60d2c4",
      "Pact-Presentation": "pres-opaque-value-0001"
    },
    "body_b64": "eyJhbW91bnQiOiIxMjAuMDAiLCJjdXJyZW5jeSI6IkVVUiJ9",
    "native_state_ref": "alice"
  },
  "call": {
    "principal": {
      "id": "https://idp.acme.example/alice",
      "realm": {"tenant_id": "acme", "environment_id": "https://gateway.example/environments/finance"},
      "workload": "https://workloads.acme.example/invoice-assistant",
      "mechanism": "bearer"
    },
    "mapping_version": "map-1"
  },
  "expect": {
    "function": "map_operation",
    "outcome": "mapped",
    "leak_scan": {
      "secrets": ["tok-alice-7f3a9c1e5b2d", "sess-cookie-93ab1f60d2c4", "pres-opaque-value-0001"]
