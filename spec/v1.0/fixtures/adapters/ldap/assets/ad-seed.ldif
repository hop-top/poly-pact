version: 1
# Directory content of the Active Directory realm of the LDAP adapter cases,
# for the unit tier only: an OpenLDAP server has neither the schema nor the
# in-chain matching rule. objectGUID is stated as 16 octets in base64.
# memberOf is not stated: the directory maintains it from member. The
# passwords are test values in clear text; they serve no deployment.

dn: DC=corp,DC=northstar,DC=example
objectClass: domainDNS
dc: corp
objectGUID:: ej8MUp1BToum8gAAAAAwAQ==

dn: CN=Users,DC=corp,DC=northstar,DC=example
objectClass: container
cn: Users
objectGUID:: ej8MUp1BToum8gAAAAAwAg==

dn: OU=Groups,DC=corp,DC=northstar,DC=example
objectClass: organizationalUnit
ou: Groups
objectGUID:: ej8MUp1BToum8gAAAAAwAw==

dn: CN=Stock Agent,CN=Users,DC=corp,DC=northstar,DC=example
objectClass: user
cn: Stock Agent
sAMAccountName: stock-agent
userPassword: Ad3!spruce-ledger-90
objectGUID:: ej8MUp1BToum8gAAAAAxAQ==
userAccountControl: 512
msDS-User-Account-Control-Computed: 0
accountExpires: 9223372036854775807
pwdLastSet: 134049024000000000

