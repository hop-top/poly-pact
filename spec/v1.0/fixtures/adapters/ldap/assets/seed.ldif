version: 1
# Directory content of the LDAP adapter cases: two realms, hq and branch, in
# one OpenLDAP 2.6 database. Each entry states its entryUUID, which a harness
# loads with the Relax Rules control or with slapadd, so that the expected
# identifiers of the cases hold. memberOf is not stated: the memberof overlay
# maintains it from the member values of the groups. The passwords are test
# values in clear text; they serve no deployment.

dn: dc=northstar,dc=example
objectClass: dcObject
objectClass: organization
dc: northstar
o: Northstar
