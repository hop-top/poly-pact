{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!schema"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noEnum": "error",
        "noParameterProperties": "error",
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/enums.ts", "src/core/shapes.ts", "src/core/types.ts"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
